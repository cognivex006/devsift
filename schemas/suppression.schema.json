{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devsift:suppression:1",
  "title": "Finding-scoped suppressions v1 (Critical security waivers forbidden)",
  "type": "array", "maxItems": 1000,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["schema_version", "rule_id", "fingerprint", "owner", "reason", "ticket", "expires_at"],
    "properties": {
      "schema_version": {"const": "1"},
      "rule_id": {"enum": ["HC001","HC003","HC004","HC005","CFG001","CFG002","COM001","COM002","COM003","ARC001","ARC002","ARC003","API001","API002","LOG001","LOG002","TST001","TST002"]},
      "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "owner": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
      "reason": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"},
      "ticket": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
      "expires_at": {"type": "string", "maxLength": 64, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
    }
  }
}
