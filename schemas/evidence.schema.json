{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devsift:evidence:1",
  "title": "DevSift source, runtime and proposal evidence v1",
  "description": "Structural wire schema. Runtime enforces ordered regions, safe paths, timestamp validity and Git verification; schema validation alone cannot establish VERIFIED.",
  "oneOf": [
    {"$ref": "#/$defs/source"},
    {"$ref": "#/$defs/runtime"},
    {"$ref": "#/$defs/proposal"}
  ],
  "$defs": {
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["start_line", "start_column", "end_line", "end_column"],
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "end_column": {"type": "integer", "minimum": 1}
      }
    },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "source_sha", "path", "region", "symbol"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 1024},
        "source_sha": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "region": {"$ref": "#/$defs/region"},
        "symbol": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024}
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "location", "before", "reason", "lookup_plan"],
          "properties": {
            "status": {"const": "VERIFIED"},
            "location": {"$ref": "#/$defs/location"},
            "before": {"type": "string", "maxLength": 2000000},
            "reason": {"type": "null"},
            "lookup_plan": {"type": "null"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "location", "before", "reason", "lookup_plan"],
          "properties": {
            "status": {"const": "SOURCE_UNRESOLVED"},
            "location": {"type": "null"},
            "before": {"type": "null"},
            "reason": {"enum": ["SOURCE_NOT_VERIFIED", "SOURCE_UNAVAILABLE", "SOURCE_MISMATCH", "REGION_UNAVAILABLE", "UNSUPPORTED_SOURCE", "SENSITIVE_LOCATION"]},
            "lookup_plan": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        }
      ]
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "message", "observed_at"],
      "properties": {
        "origin": {"type": "string", "minLength": 1, "maxLength": 4096},
        "message": {"type": "string", "maxLength": 2000000},
        "observed_at": {"type": ["string", "null"], "maxLength": 64, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "code", "confidence"],
      "properties": {
        "label": {"const": "AFTER (PROPOSAL)"},
        "code": {"type": "string", "maxLength": 2000000},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]}
      }
    }
  }
}
